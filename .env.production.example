APP_NAME="Auction Bot"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://auction.example.com
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=auction_bot
DB_USERNAME=auction
DB_PASSWORD=CHANGE_TO_A_LONG_UNIQUE_DATABASE_PASSWORD
DB_SSLMODE=disable

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
HORIZON_PREFIX=auction_bot_horizon:

FILESYSTEM_DISK=local
TELEGRAM_BOT_TOKEN=CHANGE_TO_TELEGRAM_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET=CHANGE_TO_A_LONG_RANDOM_WEBHOOK_SECRET
PAYMENT_CONTACT_NAME=CHANGE_TO_CONTACT_NAME
PAYMENT_CONTACT_HANDLE=@CHANGE_TO_CONTACT_HANDLE

# Public DNS name. The A/AAAA records must point to this server before startup.
DOMAIN=auction.example.com
CERTBOT_EMAIL=admin@example.com

# Restic repository in external S3-compatible object storage.
# Run `restic init` once after deployment; see DEPLOYMENT.md.
RESTIC_REPOSITORY=s3:https://s3.example.com/auction-bot-backups
RESTIC_PASSWORD=CHANGE_TO_A_LONG_UNIQUE_RESTIC_PASSWORD
AWS_ACCESS_KEY_ID=CHANGE_TO_OBJECT_STORAGE_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=CHANGE_TO_OBJECT_STORAGE_SECRET_KEY
AWS_DEFAULT_REGION=us-east-1
